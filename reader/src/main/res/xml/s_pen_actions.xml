<?xml version="1.0" encoding="utf-8"?>
<!--
  Vendored from upstream v0.20.4: app/src/main/res/xml/s_pen_actions.xml (modified: yes)

  Modified: the action ids drop upstream's app name, and Back's label is :i18n's `action_back`, the
  same English word as upstream's `action_webview_back`. The S Pen's air actions send these keys to
  the reader; the paged viewer turns pages on Ctrl with the left and right arrows, and the reader
  activity changes chapter on N and P.
-->
<remote-actions
    actionset_label="@string/app_name"
    version="1.2">
    <action
        id="next_page"
        label="@string/spen_next_page"
        priority="1"
        repeatable="true"
        repeatable_interval="short"
        trigger_key="CTRL_LEFT+DPAD_RIGHT">
        <preference
            name="gesture"
            value="click" />
    </action>
    <action
        id="previous_page"
        label="@string/spen_previous_page"
        priority="2"
        repeatable="true"
        repeatable_interval="short"
        trigger_key="CTRL_LEFT+DPAD_LEFT">
        <preference
            name="gesture"
            value="double_click" />
    </action>
    <action
        id="back"
        label="@string/action_back"
        priority="3"
        repeatable="true"
        repeatable_interval="short"
        trigger_key="BACK">
        <preference
            name="gesture"
            value="circle_ccw" />
    </action>
    <action
        id="next_chapter"
        label="@string/action_next_chapter"
        priority="4"
        repeatable="true"
        repeatable_interval="short"
        trigger_key="N">
        <preference
            name="gesture"
            value="swipe_right" />
    </action>
    <action
        id="previous_chapter"
        label="@string/action_previous_chapter"
        priority="5"
        repeatable="true"
        repeatable_interval="short"
        trigger_key="P">
        <preference
            name="gesture"
            value="swipe_left" />
    </action>
</remote-actions>
