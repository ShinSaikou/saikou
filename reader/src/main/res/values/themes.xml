<?xml version="1.0" encoding="utf-8"?>
<!--
  Contract 07 section 1.3. The opaque black window background is deliberate: nothing white is ever
  painted behind the reader, which is half of the fix for the grey band over a pure black page. The
  other half is `isNavigationBarContrastEnforced = false` in ReaderActivity.onCreate.

  The parent is :app's own base style, so :app must keep that name (part 2 section 7.3 item 3).
-->
<resources>
    <style name="Theme.Saikou.Reader" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/reader_background_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
