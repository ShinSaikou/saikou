<?xml version="1.0" encoding="utf-8"?>
<!--
    The launcher icon's field, converted from brand/icon-background.svg. The gradient runs top to
    bottom with a slight right lean, which the brand source records as its signature; it is two
    stops of the same red, not a colour change.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="32.4"
                android:endY="108">
                <item
                    android:offset="0"
                    android:color="#DA4223" />
                <item
                    android:offset="1"
                    android:color="#E34B29" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
