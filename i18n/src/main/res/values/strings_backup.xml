<?xml version="1.0" encoding="utf-8"?>
<!--
  Text the backup module needs. Contract 06 section 6.2 lists the keys the engine unit left for
  :backup; the two channel names, the export progress title and the share action are added here
  because the notifier of section 1.6 cannot build its notifications without them.
  action_cancel is already in the shared strings.xml and is not repeated (ruling R13).
  English text derived from upstream v0.20.4 i18n/src/commonMain/moko-resources/base/strings.xml.
-->
