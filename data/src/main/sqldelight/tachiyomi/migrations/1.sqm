-- New triggers: the clocks, the update side of two child tables and the progress log on a
-- library add.
CREATE TRIGGER update_manga_display_modified_at AFTER UPDATE OF viewer, chapter_flags ON mangas
WHEN new.is_syncing = 0 AND (new.viewer != old.viewer OR new.chapter_flags != old.chapter_flags)
BEGIN
    UPDATE mangas
    SET display_modified_at = max(strftime('%s', 'now') * 1000, coalesce(display_modified_at, 0) + 1)
    WHERE _id = new._id;
END;

CREATE TRIGGER update_manga_notes_modified_at AFTER UPDATE OF notes ON mangas
WHEN new.is_syncing = 0 AND new.notes != old.notes
BEGIN
    UPDATE mangas
    SET notes_modified_at = max(strftime('%s', 'now') * 1000, coalesce(notes_modified_at, 0) + 1)
    WHERE _id = new._id;
END;

CREATE TRIGGER update_manga_position_modified_at AFTER UPDATE OF manual_position ON mangas
WHEN new.is_syncing = 0 AND new.manual_position != old.manual_position
BEGIN
    UPDATE mangas
    SET position_modified_at = max(strftime('%s', 'now') * 1000, coalesce(position_modified_at, 0) + 1)
    WHERE _id = new._id;
END;

CREATE TRIGGER log_manga_progress_on_favorite AFTER UPDATE OF favorite ON mangas
WHEN new.is_syncing = 0 AND old.favorite = 0 AND new.favorite = 1
BEGIN
    INSERT INTO sync_change_log(entity_type, entity_id, change_type, changed_at)
    SELECT 'chapter', _id, CASE WHEN deleted_at IS NULL THEN 'upsert' ELSE 'delete' END,
           strftime('%s', 'now') * 1000
    FROM chapters
    WHERE manga_id = new._id AND (read = 1 OR bookmark = 1 OR last_page_read != 0);
END;

-- A bind moves the tracker set's clock; an insert of a pair already bound is progress (R82).
CREATE TRIGGER bind_track_modified_at BEFORE INSERT ON manga_sync
WHEN (SELECT is_syncing FROM mangas WHERE _id = new.manga_id) = 0 AND NOT EXISTS (
    SELECT 1 FROM manga_sync WHERE manga_id = new.manga_id AND sync_id = new.sync_id
)
BEGIN
    UPDATE mangas
    SET trackers_modified_at = max(strftime('%s', 'now') * 1000, coalesce(trackers_modified_at, 0) + 1)
    WHERE _id = new.manga_id;
END;

-- An undelete and every library add stamp the manga's restore clock past its tombstone (R82).
CREATE TRIGGER update_manga_restored_at AFTER UPDATE OF deleted_at, favorite ON mangas
WHEN new.is_syncing = 0 AND (
    (old.deleted_at IS NOT NULL AND new.deleted_at IS NULL) OR (old.favorite = 0 AND new.favorite = 1)
)
BEGIN
    UPDATE mangas
    SET restored_at = max(
        strftime('%s', 'now') * 1000,
        coalesce(restored_at, 0) + 1,
        coalesce(old.deleted_at, 0) + 1,
        coalesce(new.deleted_at, 0) + 1
    )
    WHERE _id = new._id;
END;

CREATE TRIGGER update_chapter_restored_at AFTER UPDATE OF deleted_at ON chapters
WHEN new.is_syncing = 0 AND old.deleted_at IS NOT NULL AND new.deleted_at IS NULL
BEGIN
    UPDATE chapters
    SET restored_at = max(strftime('%s', 'now') * 1000, coalesce(restored_at, 0) + 1, old.deleted_at + 1)
    WHERE _id = new._id;
END;

CREATE TRIGGER update_category_modified_at AFTER UPDATE OF name, sort, flags, parent_id ON categories
WHEN new.is_syncing = 0 AND (
    new.name != old.name OR new.sort != old.sort OR new.flags != old.flags OR
    new.parent_id IS NOT old.parent_id
)
BEGIN
    UPDATE categories
    SET modified_at = max(strftime('%s', 'now') * 1000, coalesce(modified_at, 0) + 1)
    WHERE _id = new._id;
END;

CREATE TRIGGER update_category_restored_at AFTER UPDATE OF deleted_at ON categories
WHEN new.is_syncing = 0 AND old.deleted_at IS NOT NULL AND new.deleted_at IS NULL
BEGIN
    UPDATE categories
    SET restored_at = max(strftime('%s', 'now') * 1000, coalesce(restored_at, 0) + 1, old.deleted_at + 1)
    WHERE _id = new._id;
END;

CREATE TRIGGER update_excluded_scanlator_change AFTER UPDATE ON excluded_scanlators
WHEN (SELECT is_syncing FROM mangas WHERE _id = new.manga_id) = 0
BEGIN
    UPDATE mangas
    SET exclusions_modified_at = max(strftime('%s', 'now') * 1000, coalesce(exclusions_modified_at, 0) + 1)
    WHERE _id = new.manga_id;
    INSERT INTO sync_change_log(entity_type, entity_id, change_type, changed_at)
    VALUES ('excluded_scanlator', new.manga_id, 'upsert', strftime('%s', 'now') * 1000);
END;

CREATE TRIGGER update_scanlator_priority_change AFTER UPDATE ON scanlator_priority
WHEN (SELECT is_syncing FROM mangas WHERE _id = new.manga_id) = 0
BEGIN
    UPDATE mangas
    SET priority_modified_at = max(strftime('%s', 'now') * 1000, coalesce(priority_modified_at, 0) + 1)
    WHERE _id = new.manga_id;
    INSERT INTO sync_change_log(entity_type, entity_id, change_type, changed_at)
    VALUES ('scanlator_priority', new.manga_id, 'upsert', strftime('%s', 'now') * 1000);
END;
