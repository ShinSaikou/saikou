-- Vendored from upstream v0.20.4: data/src/main/sqldelight/tachiyomi/data/categories.sq (modified: yes)
-- Modified: parent_id, version, is_syncing and deleted_at columns, four indices, the soft-delete
-- guard and the change-log triggers (05-data 2.2, 2.17, 2.18), and the queries of 3.2. Schema
-- version 2 (phase 3 unit C) adds the modification and restore clocks and the sync key. Phase 5 unit
-- CT adds two statements, syncGetChildIds and restoreForgetModifiedAt, and no schema change; unit
-- SC2 adds backupGetCategoryIdsByMangaIds, for the export's pages.

CREATE TABLE categories(
    _id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    sort INTEGER NOT NULL,
    flags INTEGER NOT NULL,
    parent_id INTEGER REFERENCES categories (_id) ON DELETE SET NULL,
    version INTEGER NOT NULL DEFAULT 0,
    is_syncing INTEGER NOT NULL DEFAULT 0,
    deleted_at INTEGER,
    modified_at INTEGER,
    restored_at INTEGER,
    sync_key TEXT
);

CREATE INDEX idx_categories_sort ON categories(sort);
CREATE INDEX idx_categories_parent_id ON categories(parent_id);
CREATE INDEX idx_categories_deleted_at ON categories(deleted_at) WHERE deleted_at IS NOT NULL;
CREATE INDEX idx_categories_is_syncing ON categories(is_syncing) WHERE is_syncing = 1;
-- The key two devices match a category by (phase 3 Q7), derived in Kotlin by CategorySyncKey. The
-- system category has none: it never travels.
CREATE UNIQUE INDEX idx_categories_sync_key ON categories(sync_key);

-- Category 0 is the system "uncategorised" category. Its name is empty and the UI substitutes a
-- localised label; the two guard triggers below make it undeletable.
INSERT OR IGNORE INTO categories(_id, name, sort, flags) VALUES (0, '', -1, 0);

CREATE TRIGGER system_category_delete_trigger BEFORE DELETE ON categories
BEGIN SELECT CASE WHEN old._id <= 0 THEN RAISE(ABORT, 'System category can not be deleted') END;
END;

CREATE TRIGGER system_category_soft_delete_trigger BEFORE UPDATE OF deleted_at ON categories
WHEN old._id <= 0 AND new.deleted_at IS NOT NULL
BEGIN SELECT RAISE(ABORT, 'System category can not be deleted');
END;

-- A row that stays deleted logs nothing: its tombstone was logged when it was deleted, and a
-- category re-created over it takes its new values before the restore that logs it once (phase 3
-- unit C, Q7).
CREATE TRIGGER update_category_version AFTER UPDATE ON categories
WHEN new.is_syncing = 0 AND (old.deleted_at IS NULL OR new.deleted_at IS NULL) AND (
    new.name != old.name OR new.sort != old.sort OR new.flags != old.flags OR
    new.parent_id IS NOT old.parent_id OR new.deleted_at IS NOT old.deleted_at
)
BEGIN
    UPDATE categories SET version = version + 1 WHERE _id = new._id;
    INSERT INTO sync_change_log(entity_type, entity_id, change_type, changed_at)
    VALUES ('category', new._id,
            CASE WHEN new.deleted_at IS NULL THEN 'upsert' ELSE 'delete' END,
            strftime('%s', 'now') * 1000);
END;

CREATE TRIGGER insert_category_change AFTER INSERT ON categories
WHEN new.is_syncing = 0 AND new._id > 0
BEGIN
    UPDATE categories
    SET version = version + 1,
        modified_at = max(strftime('%s', 'now') * 1000, coalesce(modified_at, 0) + 1)
    WHERE _id = new._id;
    INSERT INTO sync_change_log(entity_type, entity_id, change_type, changed_at)
    VALUES ('category', new._id, 'upsert', strftime('%s', 'now') * 1000);
END;

-- The row is gone when the push reads the log, so the delete records the sync key.
CREATE TRIGGER delete_category_change AFTER DELETE ON categories
WHEN old.is_syncing = 0
BEGIN
    INSERT INTO sync_change_log(entity_type, entity_id, change_type, changed_at, key_category)
    VALUES ('category', old._id, 'delete', strftime('%s', 'now') * 1000, old.sync_key);
END;

-- The owner's clock for the name, flags, order and parent (phase 3 Q6): max(now, previous + 1).
CREATE TRIGGER update_category_modified_at AFTER UPDATE OF name, sort, flags, parent_id ON categories
WHEN new.is_syncing = 0 AND (
    new.name != old.name OR new.sort != old.sort OR new.flags != old.flags OR
    new.parent_id IS NOT old.parent_id
)
BEGIN
    UPDATE categories
    SET modified_at = max(strftime('%s', 'now') * 1000, coalesce(modified_at, 0) + 1)
    WHERE _id = new._id;
END;

-- A restore's clock, as chapters.sq's update_chapter_restored_at.
CREATE TRIGGER update_category_restored_at AFTER UPDATE OF deleted_at ON categories
WHEN new.is_syncing = 0 AND old.deleted_at IS NOT NULL AND new.deleted_at IS NULL
BEGIN
    UPDATE categories
    SET restored_at = max(strftime('%s', 'now') * 1000, coalesce(restored_at, 0) + 1, old.deleted_at + 1)
    WHERE _id = new._id;
END;

getCategory:
SELECT *
FROM categories
WHERE _id = :id;

getCategories:
SELECT *
FROM categories
WHERE deleted_at IS NULL
ORDER BY sort;

getCategoriesByMangaId:
SELECT C.*
FROM categories C
JOIN mangas_categories MC
ON C._id = MC.category_id
WHERE MC.manga_id = :mangaId AND C.deleted_at IS NULL
ORDER BY C.sort;

-- The live categories of a page of entries (phase 5 unit SC2), in getCategoriesByMangaId's order with
-- the id breaking a tie. The export writes each as its place in that order rather than its sort
-- value, since two categories can share a sort value and the file finds a category by its value.
backupGetCategoryIdsByMangaIds:
SELECT MC.manga_id, C._id
FROM mangas_categories MC
JOIN categories C ON C._id = MC.category_id
WHERE MC.manga_id IN :mangaIds AND C.deleted_at IS NULL
ORDER BY MC.manga_id, C.sort, C._id;

getChildren:
SELECT *
FROM categories
WHERE parent_id = :parentId AND deleted_at IS NULL
ORDER BY sort;

getCategoryBySyncKey:
SELECT *
FROM categories
WHERE sync_key = :syncKey;

-- The rows the start-up backfill has not keyed yet. The system category never gets a key.
getCategoriesWithoutSyncKey:
SELECT _id, name, deleted_at
FROM categories
WHERE sync_key IS NULL AND _id > 0;

insert:
INSERT INTO categories(name, sort, flags, parent_id, sync_key)
VALUES (:name, :order, :flags, :parentId, :syncKey);

selectLastInsertedRowId:
SELECT last_insert_rowid();

updateName:
UPDATE categories
SET name = :name
WHERE _id = :categoryId;

updateOrder:
UPDATE categories
SET sort = :order
WHERE _id = :categoryId;

updateFlags:
UPDATE categories
SET flags = :flags
WHERE _id = :categoryId;

updateAllFlags:
UPDATE categories
SET flags = coalesce(:flags, flags)
WHERE deleted_at IS NULL;

updateParent:
UPDATE categories
SET parent_id = :parentId
WHERE _id = :categoryId;

-- A deleted category re-created by name takes the new values in one statement, before its restore.
updateValues:
UPDATE categories
SET name = :name, flags = :flags, parent_id = :parentId, sort = :order
WHERE _id = :categoryId;

setSyncKey:
UPDATE categories
SET sync_key = :syncKey
WHERE _id = :categoryId;

reparentChildren:
UPDATE categories
SET parent_id = NULL
WHERE parent_id = :categoryId;

-- A category a backup restore creates holds no clock of its own (phase 5 unit CT): the file has no
-- parent field (F10), so the restore's "no parent" must never beat a parent another device set, and
-- NULL orders below every clock in the merge. Only modified_at changes, which neither
-- update_category_modified_at (AFTER UPDATE OF name, sort, flags, parent_id) nor
-- update_category_version (its WHEN compares name, sort, flags, parent_id and deleted_at) reads.
restoreForgetModifiedAt:
UPDATE categories
SET modified_at = NULL
WHERE _id = :categoryId;

-- A tombstone passes the row's last restore (R82), as mangas.sq's softDelete does.
softDelete:
UPDATE categories
SET deleted_at = max(:now, coalesce(restored_at, 0) + 1)
WHERE _id = :categoryId;

-- The one write that clears deleted_at; update_category_restored_at stamps the restore clock.
restore:
UPDATE categories
SET deleted_at = NULL
WHERE _id IN :categoryIds;

resetIsSyncing:
UPDATE categories
SET is_syncing = 0
WHERE is_syncing = 1;

-- Phase 3 sync (unit E2): the rows with their parent's key, and the apply's writes under the row's
-- is_syncing latch. The system category has no key and never travels (Q7). The caller drops an
-- unkeyed row: a `sync_key IS NOT NULL` here makes the generated mapper read the parent's key as
-- non-null too, and a row with no parent then throws.
syncGetAll:
SELECT C._id, C.sync_key, C.name, C.sort, C.flags, P.sync_key AS parent_key, C.modified_at,
    C.deleted_at, C.restored_at
FROM categories C
LEFT JOIN categories P ON P._id = C.parent_id
WHERE C._id > 0;

syncGetBySyncKey:
SELECT C._id, C.sync_key, C.name, C.sort, C.flags, P.sync_key AS parent_key, C.modified_at,
    C.deleted_at, C.restored_at
FROM categories C
LEFT JOIN categories P ON P._id = C.parent_id
WHERE C._id > 0 AND C.sync_key = :syncKey;

syncSetIsSyncing:
UPDATE categories
SET is_syncing = :isSyncing
WHERE _id = :categoryId;

syncInsert:
INSERT INTO categories(name, sort, flags, parent_id, is_syncing, deleted_at, modified_at,
    restored_at, sync_key)
VALUES (:name, :sort, :flags, :parentId, 1, :deletedAt, :modifiedAt, :restoredAt, :syncKey);

syncUpdate:
UPDATE categories SET
    name = :name, sort = :sort, flags = :flags, parent_id = :parentId, modified_at = :modifiedAt,
    deleted_at = :deletedAt, restored_at = :restoredAt
WHERE _id = :categoryId;

-- The rows under a category an apply deleted, whose latches the apply raises before it reparents
-- them as the local delete does (phase 5 unit CT).
syncGetChildIds:
SELECT _id
FROM categories
WHERE parent_id = :parentId;
