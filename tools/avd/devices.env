# AVD definitions (contract 01, section 7.4).
# Fields: name|device profile|system image|RAM MB|lcd width|lcd height|lcd density[|VM heap MB]
# The lcd fields are carried here because create-avds.sh can write an AVD config directly when
# `avdmanager` is not installed, and the device profile database ships with avdmanager only.
# The VM heap is optional. It becomes the AVD's vm.heapSize, which the emulator passes to the guest
# as dalvik.vm.heapsize; an entry that names none gets SAIKOU_AVD_HEAP_MB below.
SAIKOU_AVDS=(
    "saikou_pixel8a_2g|pixel_8a|system-images;android-36;google_apis_playstore;x86_64|2048|1080|2400|420"
    "saikou_pixel9_4g|pixel_9|system-images;android-36;google_apis_playstore;x86_64|4096|1080|2424|420"
    "saikou_tablet_4g|pixel_tablet|system-images;android-36;google_apis_playstore;x86_64|4096|2560|1600|320"
    "saikou_api26_2g|pixel_8a|system-images;android-26;google_apis;x86_64|2048|1080|2400|420"
    "saikou_lowram_1_5g|pixel_8a|system-images;android-28;google_apis;x86_64|1536|1080|2400|420|384"
)
# saikou_lowram_1_5g is API 28 because it is the newest x86_64 image the emulator boots at 1.5 GB.
# The emulator raises hw.ramSize to its own floor before the guest starts, and the floor is set by
# the API level alone. Probed with -memory 1536 and -verbose on emulator 36.6.11: API 26 and 28
# keep 1536 MB, API 29 and 33 are raised to 2048 MB, API 36 to 2560 MB ("Increasing RAM size to
# 2560MB"); the levels in between were not probed. The display does not move it for a phone
# (720x1600 at 320 dpi gets the same 2560 MB on API 36), so the API 36 image ran this profile with
# 2.5 GB. The google_apis flavour, like saikou_api26_2g's, lets adb root in to profile the app.
#
# Its VM heap is 384 MB rather than the shared 512. API 28 sets no dalvik.vm.heapgrowthlimit, so
# ActivityManager.memoryClass falls back to dalvik.vm.heapsize, and at 512 a 1.5 GB profile had a
# 512 MB memory class. Ruling R61 as amended on 2026-09-24 asks for 192, the growth limit the API 36
# images give a 420 dpi phone, and for the emulator's floor if it raises that. It does: with
# -verbose, emulator 36.6.11 logs "VM heap size 192MB is below hardware specified minimum of
# 384MB,setting it to that value" for this AVD, so 384 is the floor, and naming it here keeps
# devices.env saying what the guest gets. Phase 1 step 7b checks it on the booted device.

# vm.heapSize for every entry that names none. Pinned so runs stay comparable across devices
# (contract 01, section 7.4); the low RAM row is bound to its own device (R41), so its own heap
# compares with nothing.
SAIKOU_AVD_HEAP_MB=512

# Fallbacks used when a device profile is not in the installed list (avdmanager path only).
SAIKOU_PROFILE_FALLBACK_pixel_8a=pixel_7a
SAIKOU_PROFILE_FALLBACK_pixel_9=pixel_7

# When an AVD cannot be created, the gate falls back to an AVD that already exists on the machine.
# `create-avds.sh` prints the mapping it used; the bench scripts take a plain AVD name, so these are
# what the owner passes to boot.sh until the real profile can be created.
SAIKOU_AVD_ALIAS_saikou_pixel8a_2g=Pixel_8a
SAIKOU_AVD_ALIAS_saikou_pixel9_4g=Pixel_9_4G
# saikou_api26_2g had an alias here pointing at a 1 GB API 28 phone, because cmdline-tools was not
# installed and the android-26 image could not be fetched. Both are installed now and the real AVD
# exists, so the stand-in is gone: an API 28 device standing in for the one AVD whose entire job is
# to prove minSdk 26 runs was the one substitution that proved nothing.
